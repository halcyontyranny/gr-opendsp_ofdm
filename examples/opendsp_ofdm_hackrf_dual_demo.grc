- name: send_gate_a
  id: epy_block
  parameters:
    _source_code: "import pmt\nfrom gnuradio import gr\n\n\nclass blk(gr.basic_block):\n\
      \    \"\"\"Send Gate: buffers edit-box message and enables TX when Send A is\
      \ clicked.\\nStop TX A disables TX.\"\"\"\n\n    def __init__(self, set_ptt_cb=None,\
      \ send_trigger=False, stop_trigger=False):\n        gr.basic_block.__init__(self,\
      \ name='SendGate', in_sig=None, out_sig=None)\n        self._set_ptt = set_ptt_cb\n\
      \        self._pending = None\n        self._send_trigger = bool(send_trigger)\n\
      \        self._stop_trigger = bool(stop_trigger)\n        self.message_port_register_in(pmt.intern('msg_in'))\n\
      \        self.message_port_register_out(pmt.intern('msg_out'))\n        self.set_msg_handler(pmt.intern('msg_in'),\
      \ self._on_msg)\n\n    def _on_msg(self, msg):\n        self._pending = msg\n\
      \n    @property\n    def send_trigger(self):\n        return self._send_trigger\n\
      \n    @send_trigger.setter\n    def send_trigger(self, val):\n        val =\
      \ bool(val)\n        if val and not self._send_trigger:\n            if self._set_ptt\
      \ is not None:\n                self._set_ptt(True)\n            if self._pending\
      \ is not None:\n                self.message_port_pub(pmt.intern('msg_out'),\
      \ self._pending)\n        self._send_trigger = val\n\n    @property\n    def\
      \ stop_trigger(self):\n        return self._stop_trigger\n\n    @stop_trigger.setter\n\
      \    def stop_trigger(self, val):\n        val = bool(val)\n        if val and\
      \ not self._stop_trigger:\n            if self._set_ptt is not None:\n      \
      \          self._set_ptt(False)\n        self._stop_trigger = val\n"
    send_trigger: send_btn_a
    set_ptt_cb: 'lambda v: self.set_transmit_a(v)'
    stop_trigger: stop_btn_a
  states:
    _io_cache: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [100, 380]
    rotation: 0
    state: enabled
- name: send_gate_b
  id: epy_block
  parameters:
    _source_code: "import pmt\nfrom gnuradio import gr\n\n\nclass blk(gr.basic_block):\n\
      \    \"\"\"Send Gate: buffers edit-box message and enables TX when Send B is\
      \ clicked.\\nStop TX B disables TX.\"\"\"\n\n    def __init__(self, set_ptt_cb=None,\
      \ send_trigger=False, stop_trigger=False):\n        gr.basic_block.__init__(self,\
      \ name='SendGate', in_sig=None, out_sig=None)\n        self._set_ptt = set_ptt_cb\n\
      \        self._pending = None\n        self._send_trigger = bool(send_trigger)\n\
      \        self._stop_trigger = bool(stop_trigger)\n        self.message_port_register_in(pmt.intern('msg_in'))\n\
      \        self.message_port_register_out(pmt.intern('msg_out'))\n        self.set_msg_handler(pmt.intern('msg_in'),\
      \ self._on_msg)\n\n    def _on_msg(self, msg):\n        self._pending = msg\n\
      \n    @property\n    def send_trigger(self):\n        return self._send_trigger\n\
      \n    @send_trigger.setter\n    def send_trigger(self, val):\n        val =\
      \ bool(val)\n        if val and not self._send_trigger:\n            if self._set_ptt\
      \ is not None:\n                self._set_ptt(True)\n            if self._pending\
      \ is not None:\n                self.message_port_pub(pmt.intern('msg_out'),\
      \ self._pending)\n        self._send_trigger = val\n\n    @property\n    def\
      \ stop_trigger(self):\n        return self._stop_trigger\n\n    @stop_trigger.setter\n\
      \    def stop_trigger(self, val):\n        val = bool(val)\n        if val and\
      \ not self._stop_trigger:\n            if self._set_ptt is not None:\n      \
      \          self._set_ptt(False)\n        self._stop_trigger = val\n"
    send_trigger: send_btn_b
    set_ptt_cb: 'lambda v: self.set_transmit_b(v)'
    stop_trigger: stop_btn_b
  states:
    _io_cache: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [100, 740]
    rotation: 0
    state: enabled

connections:
- [blocks_complex_to_float_a, '0', opendsp_ofdm_rx_sink_a, '0']
- [blocks_complex_to_float_b, '0', opendsp_ofdm_rx_sink_b, '0']
- [hilbert_fc_a, '0', qtgui_time_sink_tx_a, '0']
