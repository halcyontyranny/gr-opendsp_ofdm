    affinity: ''
    alias: ''
    comment: Station A decoded frames -- printed to GRC console.
    en_uvec: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [60, 484]
    rotation: 0
    state: enabled
