options:
  parameters:
    author: KF0UXU
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: OpenDSP OFDM dual-HackRF demo -- two independent half-duplex stations
      sharing center_freq. Set hackrf_a_args / hackrf_b_args to select devices (e.g.
      hackrf=0, hackrf=1, or hackrf=<serial>).
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: opendsp_ofdm_hackrf_dual_demo
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: OpenDSP OFDM -- Dual HackRF Demo
    window_size: (1400,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: callsign_a
  id: variable
  parameters:
    comment: Callsign for Station A (embedded in every TX frame).
    value: '"KF0UXU"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 100]
    rotation: 0
    state: enabled
- name: callsign_b
  id: variable
  parameters:
    comment: Callsign for Station B.
    value: '"N0CALL"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 100]
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    comment: Shared dial frequency in Hz. Both HackRFs tune here for loopback testing.
    value: 432.1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 100]
    rotation: 0
    state: enabled
- name: force_tier
  id: variable
  parameters:
    comment: 'ACM tier override: -1 = adaptive. 0=50 Hz survival, 4=2 kHz QPSK, 8=3.5
      kHz 16QAM.'
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 180]
    rotation: 0
    state: enabled
- name: hackrf_a_args
  id: variable
  parameters:
    comment: Device string for HackRF A. Use hackrf=0, hackrf=1, or hackrf=<serial>.
    value: '"hackrf=0"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 100]
    rotation: 0
    state: enabled
- name: hackrf_b_args
  id: variable
  parameters:
    comment: Device string for HackRF B. Use hackrf=0, hackrf=1, or hackrf=<serial>.
    value: '"hackrf=1"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 100]
    rotation: 0
    state: enabled
- name: hackrf_rate
  id: variable
  parameters:
    comment: HackRF sample rate. 2 MHz minimum; gives 250:1 resampling ratio.
    value: '2000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [160, 100]
    rotation: 0
    state: enabled
- name: rx_bb_gain
  id: variable
  parameters:
    comment: HackRF RX baseband (VGA) gain (dB). 0-62 dB in 2 dB steps.
    value: '16'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 180]
    rotation: 0
    state: enabled
- name: rx_if_gain
  id: variable
  parameters:
    comment: HackRF RX IF (LNA) gain (dB). 0-40 dB in 8 dB steps.
    value: '24'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 180]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: Modem audio rate -- fixed at 8000 Hz.
    value: '8000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 100]
    rotation: 0
    state: enabled
- name: transmit_a
  id: variable
  parameters:
    comment: TX state for Station A -- controlled by send_gate_a via set_transmit_a.
    value: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [700, 180]
    rotation: 0
    state: enabled
- name: transmit_b
  id: variable
  parameters:
    comment: TX state for Station B -- controlled by send_gate_b via set_transmit_b.
    value: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [900, 180]
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable
  parameters:
    comment: HackRF TX IF gain (dB). 0-47 dB in 1 dB steps.
    value: '47'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 180]
    rotation: 0
    state: enabled
- name: blocks_complex_to_float_a
  id: blocks_complex_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: Station A USB demod -- take I (real) channel.
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [500, 484]
    rotation: 0
    state: enabled
- name: blocks_complex_to_float_b
  id: blocks_complex_to_float
  parameters:
