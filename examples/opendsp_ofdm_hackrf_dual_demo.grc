    coordinate: [60, 844]
    rotation: 0
    state: enabled
- name: hilbert_fc_a
  id: hilbert_fc
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: Station A USB analytic signal (real float -> complex IQ).
    maxoutbuf: '0'
    minoutbuf: '0'
    num_taps: '65'
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [500, 308]
    rotation: 0
    state: enabled
- name: hilbert_fc_b
  id: hilbert_fc
  parameters:
    affinity: ''
